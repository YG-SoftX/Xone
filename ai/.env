# YGXONE Search Engine — Local Development
# Copy from .env.example and fill in real values for production.

# ── Security ──────────────────────────────────────────────────────────
# Set a strong, stable API key (used by search_api.php proxy internally)
YUGA_API_KEY=yg_ai_dev_local_secret_change_me_in_production
YUGA_ADMIN_PASSWORD=change_me_admin_password

# ── AI Features ──────────────────────────────────────────────────────
# false = pure BM25 search results only (no LLM calls, faster, no API key needed)
# true  = AI Overview + related questions powered by the LLM backend below
YUGA_AI_ENABLED=true

# ── LLM Backend for AI answer synthesis ───────────────────────────────
# Options: claude | openai | ollama
# Set claude + your Anthropic key for best AI answers
YUGA_LLM_BACKEND=claude
YUGA_ANTHROPIC_API_KEY=
YUGA_OPENAI_API_KEY=
YUGA_OLLAMA_URL=http://localhost:11434
YUGA_OLLAMA_MODEL=llama3.2

# ── Platform Identity ─────────────────────────────────────────────────
YUGA_ASSISTANT_NAME=Yuga
YUGA_PLATFORM_NAME=YGXONE
YUGA_TONE=professional, concise, and helpful

# ── Search Index ─────────────────────────────────────────────────────
# Primary: sovereign SQLite BM25 index
YUGA_WEB_SEARCH_PROVIDER=index

# ── Global Coverage Fallback ──────────────────────────────────────────
# When local index has < 3 results, fall back to this API for global coverage.
# Results are stored in local index — each search makes the local index smarter.
#
# Options:  brave | serpapi | none
# Brave free tier: 2,000 queries/month (enough for a small site)
# Sign up: https://api.search.brave.com/register
#
YUGA_FALLBACK_PROVIDER=none
YUGA_BRAVE_API_KEY=
YUGA_SERPAPI_KEY=

# ── Self-learning / Crawler limits ────────────────────────────────────
YUGA_AUTO_LEARN=true
YUGA_MAX_PAGES=100
YUGA_TRAIN_STEPS=15000
YUGA_TIME_LIMIT=300
YUGA_MEMORY_LIMIT=256M

# ── Database Authority ────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ygmarket_account
DB_USERNAME=ygmarket_account
DB_PASSWORD='Ygaccount@2.0##2026'

# ── YG Ecosystem URLs ─────────────────────────────────────────────────
YG_ACCOUNT_URL=https://account.ygxone.com
YG_DRIVE_URL=https://drive.ygxone.com
YG_DOCX_URL=https://docs.ygxone.com
YG_MAIL_URL=https://mail.ygxone.com
YG_MASTER_URL=https://master.ygxone.com
YG_PAY_URL=https://pay.ygxone.com
YG_CHAT_URL=https://chat.ygxone.com
YG_AI_URL=https://ai.ygxone.com

# ── YG Account SSO ───────────────────────────────────────────────────
YUGA_YG_ACCOUNT_API_SECRET=
YUGA_ADMIN_EMAILS=admin@ygxone.com

# ── Payments ─────────────────────────────────────────────────────────
YUGA_STRIPE_TEST_MODE=true
YUGA_STRIPE_SECRET_KEY=
YUGA_PAYPAL_TEST_MODE=true
YUGA_PAYPAL_CLIENT_ID=
YUGA_PAYPAL_CLIENT_SECRET=
YUGA_ESEWA_TEST_MODE=true
YUGA_ESEWA_MERCHANT_CODE=EPAYTEST
YUGA_ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
YUGA_FONEPAY_TEST_MODE=true
YUGA_IMEPAY_TEST_MODE=true
YUGA_USD_TO_NPR_RATE=133.5

# ── Email ─────────────────────────────────────────────────────────────
YUGA_MAIL_FROM_EMAIL=noreply@ygxone.com
YUGA_MAIL_FROM_NAME=YGXONE
YUGA_SMTP_HOST=mail.ygxone.com
YUGA_SMTP_PORT=587
YUGA_SMTP_USERNAME=noreply@ygxone.com
YUGA_SMTP_PASSWORD=

# ── Security Headers ─────────────────────────────────────────────────
YUGA_HSTS_ENABLED=false
YUGA_CSP_ENABLED=false
