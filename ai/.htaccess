# Prevent directory listing
Options -Indexes

# YGXONE Search Engine .htaccess
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to data & training dirs
    RewriteRule ^data/     - [F,L]
    RewriteRule ^training/ - [F,L]

    # Route root / through index.php (handles routing to home.php, search, etc.)
    RewriteRule ^$ index.php [L]

    # Route API requests to api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php?$1 [QSA,L]

    # Serve llms.txt for AI crawlers
    RewriteRule ^llms\.txt$ llms.txt [L]

    # Sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Increase limits
<IfModule mod_php7.c>
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
<IfModule mod_php8.c>
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>

# Custom error pages
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 403 /404.php

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # HSTS - forces HTTPS (ensure SSL is configured before enabling)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:;"
</IfModule>

# Block data directory
<FilesMatch "\.(db|json|sqlite)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
