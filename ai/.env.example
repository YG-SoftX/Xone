# YG AI - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Security ──────────────────────────────────────────────────────────
# Generate a strong API key for production use.
# For local dev, leave empty and config.php will auto-generate one.
YUGA_API_KEY=

# Admin panel password (minimum 8 characters)
YUGA_ADMIN_PASSWORD=

# Optional: change the admin URL slug (default: 'admin')
YUGA_ADMIN_SLUG=admin

# ── Model ─────────────────────────────────────────────────────────────
YUGA_DEFAULT_MODEL=default

# ── AI Features ──────────────────────────────────────────────────────
# Set false for pure keyword search (no LLM calls). Default: true
YUGA_AI_ENABLED=true

# ── Smart Chat LLM Backend ────────────────────────────────────────────
# Options: claude | openai | ollama
YUGA_LLM_BACKEND=claude
YUGA_ANTHROPIC_API_KEY=
YUGA_OPENAI_API_KEY=
YUGA_OLLAMA_URL=http://localhost:11434
YUGA_OLLAMA_MODEL=llama3.2

# ── Persona ───────────────────────────────────────────────────────────
YUGA_ASSISTANT_NAME=Yuga
YUGA_PLATFORM_NAME=YG Ecosystem
YUGA_TONE=professional, concise, and ecosystem-aware

# ── Ecosystem Nodes ──────────────────────────────────────────────────
# Comma-separated list of node URLs
YUGA_ECOSYSTEM_NODES=http://localhost:5000,http://localhost:5001,http://localhost:5002

# ── Self-learning ─────────────────────────────────────────────────────
YUGA_AUTO_LEARN=true
YUGA_MAX_PAGES=50
YUGA_TRAIN_STEPS=15000

# ── Resource Limits ───────────────────────────────────────────────────
YUGA_TIME_LIMIT=300
YUGA_MEMORY_LIMIT=128M

# ── Stripe ────────────────────────────────────────────────────────────
YUGA_STRIPE_TEST_MODE=true
YUGA_STRIPE_SECRET_KEY=
YUGA_STRIPE_WEBHOOK_SECRET=

# ── PayPal ────────────────────────────────────────────────────────────
YUGA_PAYPAL_TEST_MODE=true
YUGA_PAYPAL_CLIENT_ID=
YUGA_PAYPAL_CLIENT_SECRET=

# ── SMTP Email ────────────────────────────────────────────────────────
YUGA_MAIL_FROM_EMAIL=noreply@yourdomain.com
YUGA_MAIL_FROM_NAME=Yuga
YUGA_MAIL_PORTAL_URL=
YUGA_SMTP_HOST=mail.yourdomain.com
YUGA_SMTP_PORT=587
YUGA_SMTP_USERNAME=noreply@yourdomain.com
YUGA_SMTP_PASSWORD=

# ── Nepal Payments ────────────────────────────────────────────────────
YUGA_USD_TO_NPR_RATE=133.5
YUGA_ESEWA_TEST_MODE=true
YUGA_ESEWA_MERCHANT_CODE=EPAYTEST
YUGA_ESEWA_SECRET_KEY=
YUGA_FONEPAY_TEST_MODE=true
YUGA_FONEPAY_MERCHANT_ID=NBQM
YUGA_FONEPAY_SECRET_KEY=
YUGA_IMEPAY_TEST_MODE=true
YUGA_IMEPAY_MERCHANT_CODE=
YUGA_IMEPAY_MODULE=
YUGA_IMEPAY_USERNAME=
YUGA_IMEPAY_PASSWORD=

# ── Web Search ────────────────────────────────────────────────────────
YUGA_WEB_SEARCH_PROVIDER=duckduckgo
YUGA_WEB_SEARCH_API_KEY=

# ── YG Account SSO ───────────────────────────────────────────────────
# Get this from your YG Account admin panel (Admin → API Keys)
YUGA_YG_ACCOUNT_API_SECRET=

# Comma-separated list of admin emails allowed for SSO access
YUGA_ADMIN_EMAILS=admin@ygxone.com

# ── YG Ecosystem App URLs ────────────────────────────────────────────
# Used by the homepage quick-links and navigation
YG_ACCOUNT_URL=http://localhost:8000
YG_DRIVE_URL=http://localhost:8007
YG_DOCX_URL=http://localhost:8003
YG_MAIL_URL=http://localhost:3002
YG_MASTER_URL=http://localhost:8009

# ── Security Headers ─────────────────────────────────────────────────
# Enable HSTS (only after SSL is configured)
YUGA_HSTS_ENABLED=false
YUGA_HSTS_MAX_AGE=31536000

# Enable Content-Security-Policy
YUGA_CSP_ENABLED=false
YUGA_CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com;"
