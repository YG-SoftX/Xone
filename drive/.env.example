APP_NAME="YG Drive"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8007

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=yg_drive
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="drive@ygxone.com"
MAIL_FROM_NAME="${APP_NAME}"

# YG Ecosystem
YG_ACCOUNT_URL=http://localhost:8000

# Storage limits (bytes)
DRIVE_DEFAULT_QUOTA=15368709120
DRIVE_MAX_FILE_SIZE=5368709120

# YG Ecosystem URLs
VITE_APP_NAME="${APP_NAME}"
VITE_YG_ACCOUNT_URL=http://localhost:8000
