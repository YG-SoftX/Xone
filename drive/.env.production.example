# ╔═══════════════════════════════════════════════════════════════╗
# ║  YG Drive — PRODUCTION Environment Template                   ║
# ║  Copy to .env on production server. Fill in all values.       ║
# ╚═══════════════════════════════════════════════════════════════╝

APP_NAME="YG Drive"
APP_ENV=production
APP_KEY=                            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://drive.ygxone.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=14

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database (cPanel MySQL) ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanel_yg_drive
DB_USERNAME=cpanel_yg_drive_user
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# ── Session ───────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ygxone.com
SESSION_SECURE_COOKIE=true

# ── Queue & Cache ─────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ── Mail ──────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.ygxone.com
MAIL_PORT=465
MAIL_USERNAME=drive@ygxone.com
MAIL_PASSWORD=YOUR_MAIL_PASSWORD_HERE
MAIL_FROM_ADDRESS=drive@ygxone.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Ecosystem URLs ────────────────────────────────────────────────
YG_ACCOUNT_URL=https://account.ygxone.com
YG_MAIL_URL=https://mail.ygxone.com
YG_DOCX_URL=https://docx.ygxone.com
YG_MASTER_URL=https://master.ygxone.com

# ── Drive Settings ────────────────────────────────────────────────
DRIVE_DEFAULT_QUOTA=15368709120     # 15 GB per user
DRIVE_MAX_FILE_SIZE=5368709120      # 5 GB max single file

# ── Vite ─────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_YG_ACCOUNT_URL="${YG_ACCOUNT_URL}"
