APP_NAME="YGXONE Storage Node"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://drive.ygxone.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ygmarket_account
DB_USERNAME=ygmarket_account
DB_PASSWORD='Ygaccount@2.0##2026'

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ygxone.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="drive@ygxone.com"
MAIL_FROM_NAME="${APP_NAME}"

# YG Account API Configuration (for cross-module event publishing)
YG_ACCOUNT_API_BASE=https://account.ygxone.com/api
YG_ACCOUNT_API_TOKEN=your_api_token_here

YG_ACCOUNT_URL=http://localhost:8000

DRIVE_DEFAULT_QUOTA=15368709120
DRIVE_MAX_FILE_SIZE=5368709120

VITE_APP_NAME="${APP_NAME}"
VITE_YG_ACCOUNT_URL=http://localhost:8000
