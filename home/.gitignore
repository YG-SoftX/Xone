# YGXONE Browser - Git Ignore File
# Prevents committing runtime files, dependencies, and sensitive data

# ────────────────────────────────────────────────────────────────────
#  Laravel Framework
# ────────────────────────────────────────────────────────────────────
/vendor/
/node_modules/

# Compiled files
/public/hot
/public/storage
/storage/*.key

# Environment files (SENSITIVE - contains passwords/API keys)
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json

# IDE files
/.fleet/
/.idea/
/.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# ────────────────────────────────────────────────────────────────────
#  Laravel Storage & Cache (Runtime-generated)
# ────────────────────────────────────────────────────────────────────
bootstrap/cache/*.php
!bootstrap/cache/.gitkeep

storage/framework/cache/*
!storage/framework/cache/.gitkeep

storage/framework/sessions/*
!storage/framework/sessions/.gitkeep

storage/framework/testing/*
!storage/framework/testing/.gitkeep

storage/framework/views/*
!storage/framework/views/.gitkeep

storage/logs/*
!storage/logs/.gitkeep

storage/app/*
!storage/app/.gitkeep
!storage/app/public/.gitkeep

# ────────────────────────────────────────────────────────────────────
#  Logs & Error Files
# ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log
yarn-error.log
error_log
ai/error_log
ai/portal/error_log
collect/error_log
console/error_log
mail/public/error_log
master/error_log
master/public/error_log
notes/error_log

# ────────────────────────────────────────────────────────────────────
#  Build Output
# ────────────────────────────────────────────────────────────────────
/dist/
/build/
/public/build/
/mix-manifest.json
/hot

# Compiled assets
*.js.map
*.css.map

# ────────────────────────────────────────────────────────────────────
#  Testing
# ────────────────────────────────────────────────────────────────────
/.phpunit.result.cache
coverage/
.php_cs.cache

# ────────────────────────────────────────────────────────────────────
#  Temporary Files
# ────────────────────────────────────────────────────────────────────
.ea-php-cli.cache
*.tmp
*.temp
.cache/

# ────────────────────────────────────────────────────────────────────
#  Payment Module (If sensitive)
# ────────────────────────────────────────────────────────────────────
/pay/

# ────────────────────────────────────────────────────────────────────
#  Support Directory (If contains local configs)
# ────────────────────────────────────────────────────────────────────
support/.htaccess
