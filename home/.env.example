# =============================================================================
# YGXone Home — Environment Variables
# =============================================================================
# These variables override the defaults in config.php.
# On cPanel: set via cPanel > Software > PHP INI Editor, or use a .htaccess
# SetEnv directive, or set them in your server environment.
#
# .htaccess example (add below the Options line):
#   SetEnv APP_URL https://ygxone.com
#   SetEnv YG_ACCOUNT_URL https://account.ygxone.com
#   SetEnv YG_AI_API_URL https://ai.ygxone.com
# =============================================================================

# ── Site ──────────────────────────────────────────────────────────────────────
APP_URL=https://ygxone.com

# ── YG AI Search (choose ONE method) ─────────────────────────────────────────
# Option A: Cross-server HTTP API (recommended for production)
YG_AI_API_URL=https://ai.ygxone.com

# Option B: Local file access (same server, set absolute path)
# YG_AI_ROOT=/home/cpanelusername/yg-ai

# ── YG AI Search Configuration ────────────────────────────────────────────────
# YG AI Service (Your own AI platform)
YG_AI_URL=https://ai.ygxone.com
YG_AI_API_KEY=your_yg_ai_api_key_here
YG_AI_TIMEOUT=10

# ── Ecosystem Service URLs & API Keys ─────────────────────────────────────────
YG_ACCOUNT_URL=https://account.ygxone.com
YG_ACCOUNT_API_KEY=your_account_api_key

YG_MAIL_URL=https://mail.ygxone.com
YG_MAIL_API_KEY=your_mail_api_key

YG_DRIVE_URL=https://drive.ygxone.com
YG_DRIVE_API_KEY=your_drive_api_key

YG_DOCX_URL=https://docs.ygxone.com
YG_DOCX_API_KEY=your_docx_api_key

YG_CALENDAR_URL=https://calendar.ygxone.com
YG_CALENDAR_API_KEY=your_calendar_api_key

YG_CONTACTS_URL=https://contacts.ygxone.com
YG_CONTACTS_API_KEY=your_contacts_api_key

YG_MEET_URL=https://meet.ygxone.com
YG_CHAT_URL=https://chat.ygxone.com
YG_PAY_URL=https://pay.ygxone.com
YG_MASTER_URL=https://master.ygxone.com
YG_NEWS_URL=https://news.ygxone.com

# ── Admin Configuration ───────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@ygxone.com,superadmin@ygxone.com

# Comma-separated list of admin user IDs (alternative method)
ADMIN_USER_IDS=1,2

# ── Session Configuration (SSO Support) ───────────────────────────────────────
# For SSO across all *.ygxone.com sub-domains:
SESSION_DRIVER=database
SESSION_DOMAIN=.ygxone.com
SESSION_LIFETIME=120

# For local development (file-based sessions):
# SESSION_DRIVER=file
# SESSION_DOMAIN=
