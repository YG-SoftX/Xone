# =============================================================================
# YGXone Home — Environment Variables
# =============================================================================
# Copy this file to .env and update values for your environment
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="YGXONE Search"
APP_ENV=local
APP_KEY=base64:pNAq7Z1IFlUco78dJQgNg194EaPTa8Q6vneb/UXOFVQ=
APP_DEBUG=true
APP_URL=http://localhost:8001

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (YG Unified MySQL) ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ygmarket_account
DB_USERNAME=ygmarket_account
DB_PASSWORD='Ygaccount@2.0##2026'

# DB_CONNECTION=sqlite

# ── Cache & Session (cPanel Optimized) ────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# ── File Storage ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Broadcast ─────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── YG AI Search Configuration ────────────────────────────────────────────────
# YG AI Service (Your own AI platform)
YG_AI_URL=https://ai.ygxone.com/api
YG_AI_API_KEY=yg_ai_dev_local_secret_change_me_in_production
YG_AI_PUBLIC_KEY=public_ai_key_2026
YG_AI_TIMEOUT=15

# ── Ecosystem Service URLs ────────────────────────────────────────────────────
YG_ACCOUNT_URL=https://account.ygxone.com
YG_ACCOUNT_API_KEY=your_account_api_key

YG_MAIL_URL=https://mail.ygxone.com
YG_MAIL_API_KEY=your_mail_api_key

YG_DRIVE_URL=https://drive.ygxone.com
YG_DRIVE_API_KEY=your_drive_api_key

YG_DOCX_URL=https://docs.ygxone.com
YG_DOCX_API_KEY=your_docx_api_key

YG_CALENDAR_URL=https://calendar.ygxone.com
YG_CALENDAR_API_KEY=your_calendar_api_key

YG_CONTACTS_URL=https://contacts.ygxone.com
YG_CONTACTS_API_KEY=your_contacts_api_key

# ── Admin Configuration ───────────────────────────────────────────────────────
# IMPORTANT: Configure at least ONE admin user before accessing /admin/dashboard

# Method 1: Admin Email Addresses (comma-separated)
# Add your email addresses here - users with these emails will have admin access
ADMIN_EMAILS=admin@ygxone.com

# Method 2: Admin User IDs (comma-separated, from users table)
# Alternative method if you prefer ID-based authorization
ADMIN_USER_IDS=1

# Example configurations:
# Single admin: ADMIN_EMAILS=your@email.com
# Multiple admins: ADMIN_EMAILS=admin@ygxone.com,superadmin@ygxone.com,dev@ygxone.com
# Mixed: Use both ADMIN_EMAILS and ADMIN_USER_IDS together

# ── Security Settings (Production) ────────────────────────────────────────────
# Uncomment and configure for production deployment
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax