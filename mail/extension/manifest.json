{
  "manifest_version": 3,
  "name": "YG Sovereign Mail — Extension",
  "version": "1.0.0",
  "description": "Secure, sovereign notifications for your YG Mail. No data leaves Nepal.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
  },
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:5007/*"
  ]
}
