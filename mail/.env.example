APP_NAME="YG Mail"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mail.ygxone.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ygmarket_account
DB_USERNAME=ygmarket_account
DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ygxone.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# --- Outgoing Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=your_mail_host
MAIL_PORT=587
MAIL_USERNAME=your_mail_user
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS="noreply@ygxone.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Incoming Mail (IMAP) ---
MAIL_INCOMING_HOST=mail.ygxone.com
MAIL_INCOMING_PORT=993
MAIL_INCOMING_ENCRYPTION=ssl
MAIL_INCOMING_USERNAME=no-reply@ygxone.com
MAIL_INCOMING_PASSWORD=your_mail_password

VITE_APP_NAME="${APP_NAME}"

# YG Ecosystem URLs (Production)
YG_ACCOUNT_URL=https://account.ygxone.com
MASTER_API_URL=https://master.ygxone.com

VITE_YG_ACCOUNT_URL=https://account.ygxone.com
VITE_MASTER_API_URL=https://master.ygxone.com
VITE_YG_MAIL_URL=https://mail.ygxone.com
VITE_YG_DRIVE_URL=https://drive.ygxone.com
VITE_YG_DOCX_URL=https://docx.ygxone.com
VITE_YG_MEET_URL=https://meet.ygxone.com
VITE_YG_CHAT_URL=https://chat.ygxone.com
VITE_YG_PAY_URL=https://pay.ygxone.com
