APP_NAME="YG Mail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yg_mail
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Outgoing Mail (SMTP) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Incoming Mail (IMAP) ---
MAIL_INCOMING_HOST=mail.ygxone.com
MAIL_INCOMING_PORT=993
MAIL_INCOMING_ENCRYPTION=ssl
MAIL_INCOMING_USERNAME=no-reply@ygxone.com
MAIL_INCOMING_PASSWORD=your_mail_password

VITE_APP_NAME="${APP_NAME}"

# YG Ecosystem URLs
YG_ACCOUNT_URL=http://localhost:8000
MASTER_API_URL=http://localhost:8001

VITE_YG_ACCOUNT_URL=http://localhost:8000
VITE_MASTER_API_URL=http://localhost:8001
VITE_YG_MAIL_URL=http://localhost:3002
VITE_YG_DRIVE_URL=http://localhost:3007
VITE_YG_DOCX_URL=http://localhost:8003
VITE_YG_MEET_URL=http://localhost:3009
VITE_YG_CHAT_URL=http://localhost:8006
VITE_YG_PAY_URL=http://localhost:3001
