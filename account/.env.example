# ╔══════════════════════════════════════════════════════╗
# ║  YG Account — cPanel Optimized Configuration        ║
# ║  Copy to .env and fill in real values.               ║
# ║  NEVER commit .env to version control.               ║
# ╚══════════════════════════════════════════════════════╝

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="YG Account"
APP_ENV=production          # MUST be production on cPanel
APP_KEY=                    # Generate with: php artisan key:generate
APP_DEBUG=false             # MUST be false in production (security risk!)
APP_URL=https://account.ygxone.com  # Your actual domain
YG_ACCOUNT_URL=https://account.ygxone.com  # SSO token validation endpoint

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12            # Balanced for cPanel performance

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=single          # Single file for easier management on cPanel
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error             # Reduce logging to save disk space on shared hosting

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql         # MySQL only (cPanel standard)
DB_HOST=localhost           # Usually localhost on cPanel
DB_PORT=3306
DB_DATABASE=username_yg_account    # Replace 'username' with your cPanel username
DB_USERNAME=username_dbuser        # Replace with your database user
DB_PASSWORD=your_secure_password   # Use strong password

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database     # Database session (no Redis on shared hosting)
SESSION_LIFETIME=120
SESSION_ENCRYPT=true        # MUST be true in production
SESSION_PATH=/
SESSION_DOMAIN=.ygxone.com  # Enable cross-subdomain SSO
SESSION_SECURE_COOKIE=true  # Force HTTPS cookies

# ── Cache & Queue ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log    # Disable broadcasting (no WebSockets on cPanel)
FILESYSTEM_DISK=local       # Local storage only (no S3 unless configured)
QUEUE_CONNECTION=sync       # SYNC mode for cPanel (no persistent queue workers)
CACHE_STORE=database        # Database cache (no Redis on shared hosting)

# ── Redis (optional — cPanel may not have Redis) ──────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log             # Change to "smtp" in production
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (optional) ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Admin Panel ───────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com          # Comma-separated admin email addresses
ADMIN_SESSION_TIMEOUT=60                # Minutes before idle admin session expires
ADMIN_MAX_LOGIN_ATTEMPTS=5              # Failed attempts before lockout
ADMIN_LOCKOUT_MINUTES=15               # Lockout duration after max attempts

# ── Vite (frontend build) ─────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================

# Default payment provider (stripe, paypal, razorpay)
PAYMENT_DEFAULT_PROVIDER=stripe

# Enable/disable providers
PAYMENT_STRIPE_ENABLED=true
PAYMENT_PAYPAL_ENABLED=true
PAYMENT_RAZORPAY_ENABLED=true

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_CURRENCY=USD

# PayPal Configuration
PAYPAL_MODE=sandbox  # Change to 'live' for production
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_CURRENCY=USD

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=INR

# Payment Settings
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_TIMEOUT=30
PAYMENT_MIN_AMOUNT=1.00
PAYMENT_MAX_AMOUNT=999999.99

# Currency Conversion (optional)
CURRENCY_CONVERSION_ENABLED=false
BASE_CURRENCY=USD

# Webhook Security
PAYMENT_VERIFY_SIGNATURE=true
PAYMENT_WEBHOOK_IPS=  # Comma-separated IPs if needed

# Payment Logging
PAYMENT_LOG_TRANSACTIONS=true
PAYMENT_LOG_LEVEL=info

# =============================================================================
# CRON JOB MONITORING & ALERTING CONFIGURATION
# =============================================================================

# Admin Email for Cron Alerts
ADMIN_EMAIL=admin@ygxone.com

# Backup Configuration
BACKUP_DIRECTORY=storage/app/backups
BACKUP_RETENTION_DAYS=30

# ── Slack Webhook Integration ────────────────────────────────────────────────
CRON_ALERT_SLACK_ENABLED=false
CRON_ALERT_SLACK_PLATFORM=slack
CRON_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ── Discord Webhook Integration ──────────────────────────────────────────────
CRON_ALERT_DISCORD_ENABLED=false
CRON_ALERT_DISCORD_PLATFORM=discord
CRON_ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# ── Twilio SMS Alerts ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890  # Your Twilio phone number (E.164 format)
TWILIO_ADMIN_PHONES=+1234567890,+0987654321  # Comma-separated admin phone numbers
TWILIO_ONCALL_PHONE=+1234567890  # On-call engineer phone for escalations

# ── Firebase Push Notifications ──────────────────────────────────────────────
FCM_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_DEVICES=device_token_1,device_token_2  # Comma-separated device tokens

# ── Grafana Analytics Integration ────────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086  # Your InfluxDB instance URL
INFLUXDB_TOKEN=your_influxdb_api_token
INFLUXDB_BUCKET=cron_metrics
INFLUXDB_ORG=yg_account
GRAFANA_DASHBOARD_URL=http://localhost:3000  # Your Grafana dashboard URL

# ── PagerDuty Incident Management ────────────────────────────────────────────
PAGERDUTY_API_KEY=your_pagerduty_api_key
PAGERDUTY_SERVICE_ID=your_service_id
PAGERDUTY_ROUTING_KEY=your_integration_routing_key

# ── Deployment & Rollback Configuration ──────────────────────────────────────
DEPLOYMENT_BACKUP_DIRECTORY=storage/app/deployments
DEPLOYMENT_AUTO_ROLLBACK_ENABLED=false  # Set to true for automatic rollback on critical failures

# ── Custom Webhook Integrations ──────────────────────────────────────────────
# Example: Zapier webhook
ZAPIER_WEBHOOK_SECRET=your_zapier_secret_key
# Example: Make.com (Integromat) webhook
MAKE_WEBHOOK_SECRET=your_make_secret_key
# Example: n8n automation webhook
N8N_WEBHOOK_SECRET=your_n8n_secret_key

# ── Escalation Policy Configuration ──────────────────────────────────────────
ESCALATION_ENABLE_PHONE_CALLS=false  # Set true to enable phone call escalations
TWILIO_MANAGER_PHONE=+1234567890  # Engineering manager phone for level 3 escalation

# ── YG AI Machine Learning Configuration ─────────────────────────────────────
YG_AI_MODEL_VERSION=1.0
YG_AI_TRAINING_DATA_DAYS=90
YG_AI_CONFIDENCE_THRESHOLD=0.75
