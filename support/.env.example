APP_NAME=YGXONE Support
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://support.ygxone.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ygmarket_account
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# YG Account SSO
YG_ACCOUNT_URL=https://account.ygxone.com
YG_ACCOUNT_API_BASE=https://account.ygxone.com

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.ygxone.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@ygxone.com
MAIL_FROM_NAME="YG Support"
