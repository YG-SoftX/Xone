# ╔═══════════════════════════════════════════════════════════════╗
# ║  YG Developer Portal — PRODUCTION Environment Template        ║
# ║  Copy to .env on production server. Fill in all values.       ║
# ╚═══════════════════════════════════════════════════════════════╝

APP_NAME="YG Developer"
APP_ENV=production
APP_KEY=                            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://developer.ygxone.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=14

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database (cPanel MySQL) ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanel_yg_developer
DB_USERNAME=cpanel_yg_developer_user
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# ── Session ───────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ygxone.com
SESSION_SECURE_COOKIE=true

# ── Queue & Cache ─────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ── Mail ──────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.ygxone.com
MAIL_PORT=465
MAIL_USERNAME=developer@ygxone.com
MAIL_PASSWORD=YOUR_MAIL_PASSWORD_HERE
MAIL_FROM_ADDRESS=developer@ygxone.com
MAIL_FROM_NAME="${APP_NAME}"

# ── YG Account SSO (REQUIRED — this app authenticates via YG Account) ─────────
YG_ACCOUNT_URL=https://account.ygxone.com
YG_ACCOUNT_API_URL=https://account.ygxone.com/api

# ── Vite ─────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
