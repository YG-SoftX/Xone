APP_NAME="YGXONE Temporal Node"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://calendar.ygxone.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ygmarket_account
DB_USERNAME=ygmarket_account
DB_PASSWORD=your_db_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ygxone.com

YG_ACCOUNT_URL=https://account.ygxone.com

# YG Account API Configuration (for cross-module event publishing)
YG_ACCOUNT_API_BASE=https://account.ygxone.com/api
YG_ACCOUNT_API_TOKEN=your_api_token_here

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
